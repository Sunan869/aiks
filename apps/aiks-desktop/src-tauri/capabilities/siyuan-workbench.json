{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "siyuan-workbench-events",
  "description": "Allow the embedded loopback SiYuan workbench to emit sanitized AIKS bridge events only.",
  "windows": ["knowledge"],
