{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "siyuan-workbench-events",
  "description": "Allow only the embedded/fallback loopback SiYuan webviews to emit sanitized AIKS bridge events.",
  "webviews": ["siyuan-workbench", "knowledge"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:event:allow-emit"
  ]
}
