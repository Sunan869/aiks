{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "siyuan-workbench-bridge",
  "description": "Allow only Bridge event emission from the embedded loopback SiYuan workbench.",
  "local": false,
  "webviews": ["siyuan-workbench", "knowledge"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:event:allow-emit"
  ]
}
