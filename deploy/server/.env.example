# ===== Image / container =====
AIKS_COLLECTOR_IMAGE=aiks-service:weknora-collector
AIKS_COLLECTOR_CONTAINER_NAME=aiks-collector

# ===== Shared docker network =====
# Must be the same value as the aiks-WeKnora server deployment.
AIKS_TEAM_NETWORK=aiks-team-network

# ===== Collector authentication =====
# start.sh auto-generates this when .env is first created.
AIKS_COLLECTOR_TOKEN=

# ===== WeKnora =====
# When both compose projects are on the same server/network, keep this internal URL.
AIKS_WEKNORA_BASE_URL=http://weknora-app:8080

# Required: server-side WeKnora platform API key used only by aiks-service
# for durable writes after the employee target workspace/KB was verified.
# Create/fill it after WeKnora starts.
AIKS_WEKNORA_API_KEY=
AIKS_WEKNORA_CHANNEL=aiks

# ===== Host exposure =====
# Keep loopback when Nginx/TongHttpServer provides HTTPS externally.
AIKS_COLLECTOR_BIND=127.0.0.1
AIKS_COLLECTOR_PORT=28082
AIKS_COLLECTOR_DATA_DIR=./data
