# Images (built locally and pushed to registry before server deployment)
AIKS_IMAGE=registry.example.com/aiks/aiks-service:v0.1.0
SIYUAN_IMAGE=b3log/siyuan:latest

AIKS_CONTAINER_NAME=aiks-service-team
SIYUAN_CONTAINER_NAME=aiks-siyuan
AIKS_DATA_DIR=/data/aiks/service
AIKS_SIYUAN_DATA_DIR=/data/aiks/siyuan
AIKS_SERVICE_PORT=28081

AIKS_PUBLIC_HOST=aiks.example.com
AIKS_PUBLIC_BASE_URL=https://aiks.example.com

AIKS_DINGTALK_CORP_ID=
AIKS_DINGTALK_CLIENT_ID=
AIKS_DINGTALK_CLIENT_SECRET=
AIKS_DINGTALK_ROOT_DEPARTMENT_IDS=1
AIKS_DIRECTORY_REFRESH_SECONDS=300
AIKS_DIRECTORY_MAX_STALE_SECONDS=900
AIKS_LOGIN_ATTEMPT_TTL_SECONDS=300
AIKS_ACCESS_TOKEN_TTL_SECONDS=900
AIKS_REFRESH_TOKEN_TTL_SECONDS=604800

AIKS_SIYUAN_BASE_URL=http://127.0.0.1:6806
AIKS_SIYUAN_TOKEN=
AIKS_SIYUAN_NOTEBOOK_NAME=AIKS
AIKS_SIYUAN_SESSION_NOTEBOOK_NAME=AIKS
AIKS_SIYUAN_SESSION_ROOT=/10 AI Sessions
AIKS_SIYUAN_KNOWLEDGE_ROOT=/20 Knowledge

AIKS_AI_ENABLED=false
AIKS_AI_BASE_URL=
AIKS_AI_MODEL=
AIKS_AI_API_KEY=
AIKS_AI_TIMEOUT_SECONDS=120
AIKS_AI_MAX_CONCURRENT=1

AIKS_EMBEDDING_ENABLED=false
AIKS_EMBEDDING_BASE_URL=
AIKS_EMBEDDING_MODEL=
AIKS_EMBEDDING_API_KEY=
AIKS_EMBEDDING_BATCH_SIZE=16
AIKS_EMBEDDING_CHUNK_TARGET_TOKENS=800
AIKS_EMBEDDING_CHUNK_MAX_TOKENS=1200
AIKS_EMBEDDING_CHUNK_OVERLAP_TOKENS=120
