server {
    listen 443 ssl http2;
    server_name aiks.example.com;

    ssl_certificate     /etc/aiks/tls/fullchain.pem;
    ssl_certificate_key /etc/aiks/tls/privkey.pem;

    client_max_body_size 16m;

    # Only AIKS routes are reachable. SiYuan is never proxied.
    location = /healthz {
        proxy_pass http://127.0.0.1:28081;
        proxy_set_header Host aiks.example.com;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Original-Host "";
    }

    location ~ ^/api/v1/(auth/dingtalk/(start|browser|callback|exchange)|auth/(refresh|logout)|me|capabilities|source-registrations|session-snapshots|sessions(?:/[^/]+)?|receipts/[^/]+|jobs/[^/]+|search|knowledge(?:/.*)?|content-operations/[^/]+|directory/search)$ {
        proxy_pass http://127.0.0.1:28081;
        proxy_set_header Host aiks.example.com;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Original-Host "";
        proxy_http_version 1.1;
        proxy_request_buffering on;
    }

    location / {
        return 404;
    }
}
