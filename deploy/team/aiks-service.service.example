[Unit]
Description=AIKS single-company team service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aiks
Group=aiks
UMask=0077
EnvironmentFile=/etc/aiks/team.env
ExecStart=/opt/aiks/bin/aiks-service --config /etc/aiks/service.toml
Restart=on-failure
RestartSec=5
WorkingDirectory=/var/lib/aiks-team
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aiks-team
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
