# Generate with: openssl rand -hex 32
AIKS_COLLECTOR_TOKEN=

# WeKnora server and target knowledge base
AIKS_WEKNORA_BASE_URL=http://weknora.example.internal:8080
AIKS_WEKNORA_KNOWLEDGE_BASE_ID=
AIKS_WEKNORA_API_KEY=
AIKS_WEKNORA_CHANNEL=aiks

# Keep loopback when an HTTPS reverse proxy runs on the same server.
AIKS_COLLECTOR_BIND=127.0.0.1
AIKS_COLLECTOR_PORT=28082
AIKS_COLLECTOR_DATA_DIR=./data
